# Copia a .env y rellena. .env está en .gitignore.
# Pon límite de gasto en el panel de cada proveedor ANTES de usar la key.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres con pgvector
DATABASE_URL=postgres://ai_path:ai_path_local@localhost:5432/ai_path_dev
# Si el 5432 ya está ocupado: PGPORT=5433 docker compose up -d
# y ajusta el puerto de arriba.

# Presupuesto mensual auto-impuesto, en USD. Los scripts avisan al 80%.
MONTHLY_BUDGET_USD=40
